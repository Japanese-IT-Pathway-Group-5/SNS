{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "claymore",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sns-db",
			"database_id": "d190c65c-ef7a-422b-8081-895a524c1b99",
			"migrations_dir": "drizzle"
		}
	],

	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "japanese-it-pathway-sns-media"
		}
	],

	"vars": {
		"BETTER_AUTH_URL": "https://claymore.jitp-group5.workers.dev"
	},
	"ratelimits": [
		{
			"name": "POST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "UPLOAD_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
